# 高德地图Web服务API Key（可选）
# 申请地址：https://console.amap.com/dev/key/app
AMAP_WEB_KEY=

# DeepSeek 兼容函数调用接口。只保存在后端，切勿配置到 VITE_* 环境变量。
# 留空密钥时对话显示未配置，表单筛选仍可用；填写后重启后端生效。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=
# 使用其他兼容服务时可将 BASE_URL 改为其地址（允许带 /v1）。
# 本程序自动添加 /chat/completions，不要在 BASE_URL 重复填写该路径。
# 本地模型服务也需填写非空占位密钥，例如 local；须支持 tools/tool_choice。
